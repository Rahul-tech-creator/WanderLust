<% layout("/layouts/boilerplate") %>

<style>
.booking{
    border-radius: 20px;
}
</style>
<br>

<form action="/bookings/requests">
    <button class="btn btn-danger booking">Booking Requests</button>
</form>

<br><br>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">

    <% for (let booking of bookings) { %>

        <div class="card col listing-card">

            <img
                src="<%= booking.listing.image.url %>"
                class="card-img-top"
                alt="listing_image"
                style="height: 20rem;"
            >

            <div class="card-body">

                <p class="card-text">
                    <b><%= booking.listing.title %></b>
                </p>

                <p class="card-text">
                    &#8377; <%= booking.listing.price.toLocaleString("en-IN") %> / night
                   
                </p>

                <p class="card-text">
                    Check-In:
                    <%= booking.checkIn.toLocaleDateString("en-IN") %>
                </p>

                <p class="card-text">
                    Check-Out:
                    <%= booking.checkOut.toLocaleDateString("en-IN") %>
                </p>

                <p class="card-text">
                    Guests: <%= booking.guests %>
                </p>

                <p class="card-text">
                    <b>
                        Total:
                        &#8377; <%= booking.price.toLocaleString("en-IN") %>
                         <b><i class="tax-info">&nbsp; +18% GST</i></b>
                    </b>
                </p>

                <p class="card-text">
                    Status:
                    <b><%= booking.status %></b>
                </p>

            </div>

        </div>

    <% } %>

</div>
